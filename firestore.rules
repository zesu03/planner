rules_version = '2';

// Firestore security rules.
//
// Single principle: every user owns exactly one document at users/{uid}
// (plus any future subcollections under that path), and nobody else can
// see or touch it. The app's entire data model — goals, prayer log,
// muhasaba, qaza, focus log, saved verses, notification tokens — lives
// inside that document, so this single rule covers the whole surface.
//
// Without these rules, the default mode is "test" (open until a deadline)
// or "locked" (all denied). Both fail differently:
//   - test mode means any authenticated user can read every other user's
//     muhasaba entries, hijack FCM tokens to receive their prayer pushes,
//     wipe their goals. P0 leak.
//   - locked mode breaks the app entirely.
//
// Deploy with: firebase deploy --only firestore:rules
//   (this is SEPARATE from the Vercel app deploy — pushing to git does NOT
//    update Firestore rules; they only change when you run the command above.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Belt-and-braces against the recurring qaza-ledger WIPE, enforced
    // SERVER-SIDE so no client version can bypass it (a stale service-worker
    // bundle running old code across a deploy boundary is exactly how the wipe
    // recurs; a client-side guard can't help while the OLD bundle is running).
    //
    // A healthy ledger's `startDate` is an immutable anchor. The wipe replaces
    // the whole ledger with a fresh emptyQaza whose startDate is TODAY —
    // strictly LATER than the real anchor. So: DENY only when an existing
    // qaza.startDate would move FORWARD. Fail-open in every other case (create,
    // delete, subcollection docs with no qaza, unchanged startDate, startDate
    // moving earlier) so no legitimate write is ever blocked — availability must
    // not regress to prevent a rare wipe. Admin SDK writes (backups/restores)
    // bypass rules entirely, so recovery is unaffected.
    function qazaStartDateNotMovingForward() {
      return !(
        resource != null
        && 'qaza' in resource.data
        && resource.data.qaza is map
        && 'startDate' in resource.data.qaza
        && request.resource != null
        && 'qaza' in request.resource.data
        && request.resource.data.qaza is map
        && 'startDate' in request.resource.data.qaza
        && request.resource.data.qaza.startDate > resource.data.qaza.startDate
      );
    }

    // Owner-only access to the user doc and any subcollections under it.
    // The {document=**} wildcard future-proofs the migration to a
    // muhasaba subcollection (noted in CLAUDE.md as the long-term fix
    // for the 1 MB doc size limit).
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Writes require ownership AND that the write is not a qaza wipe. The
      // guard is a no-op for subcollection docs (no `qaza` field) and for every
      // legitimate main-doc write (startDate never moves forward).
      allow write: if request.auth != null && request.auth.uid == uid
        && qazaStartDateNotMovingForward();
    }

    // Default deny. Anything not matched above is forbidden, including
    // accidental top-level collections introduced later without rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
